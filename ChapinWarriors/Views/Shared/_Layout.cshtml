<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Chapin Warriors</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="encabezado">
        <a href="@Url.Action("Index", "Home")" class="logo">Chapin Warriors</a>
        <nav>
            <a href="@Url.Action("Cargar", "Configuracion")">Configuracion</a>
            <a href="@Url.Action("Seleccionar", "Misiones")">Misiones</a>
        </nav>
    </header>

    <main class="contenido">
        @RenderBody()
    </main>

    <footer class="pie">
        <p>USAC - Facultad de Ingenieria - Introduccion a la Programacion y Computacion 2 - Proyecto 1</p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
